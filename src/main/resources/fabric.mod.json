{
	"schemaVersion": 1,
	"id": "minecraft_parallax",
	"version": "${version}",
	"name": "Minecraft Parallax",
	"description": "Webcam head tracking + off-axis projection: your monitor becomes a window into the Minecraft world (head-coupled perspective, Johnny Lee style).",
	"authors": [
		"Roger Vendrell"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/minecraft_parallax/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.rogervendrell.minecraftparallax.ParallaxClient"
		]
	},
	"mixins": [
		"minecraft_parallax.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
