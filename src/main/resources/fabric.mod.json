{
	"schemaVersion": 1,
	"id": "depthwindow",
	"version": "${version}",
	"name": "Depth Window",
	"description": "Webcam head tracking + off-axis projection: your monitor becomes a window into the Minecraft world (head-coupled perspective, Johnny Lee style).",
	"authors": [
		"Roger Vendrell"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/depthwindow/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.rogervendrell.depthwindow.DepthWindowClient"
		]
	},
	"mixins": [
		"depthwindow.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
